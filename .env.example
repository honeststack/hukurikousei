# 未設定なら .data/pglite に組込みPostgreSQL（PGlite）を作成して使います。
# 本番では PostgreSQL の接続文字列を設定してください。
# DATABASE_URL=postgres://user:pass@host:5432/yufuda

# セッション・QR・日替わり色の署名に使う秘密鍵（本番では必ず32文字以上のランダム値に変更）
APP_SECRET=change-me-to-a-long-random-string-0123456789

# 公開URL（招待メール・施設QRのURLに使用）
APP_URL=http://localhost:3000

# 月次処理APIの認証トークン（外部スケジューラから POST /api/cron/monthly を呼ぶ場合）
CRON_SECRET=change-me-cron

# メール送信（未設定なら送信せず「送信記録」に保存し、コンソールに出力）
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM="湯札 事務局 <no-reply@example.com>"

# true にすると運営アカウントに2段階認証を必須にします
REQUIRE_ADMIN_2FA=false
